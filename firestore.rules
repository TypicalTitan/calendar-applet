rules_version = '2';

// Who may do what
// ---------------
// "Runs the event" means: made it (ownerUid), or joined through a one-time link (owners, below).
//
// events/{eventId}
//   read one       anyone who knows the id (the id is the invite link's secret)
//   list           only events you made (events you run with others are found through owners)
//   create         an account holder with a confirmed email, as themselves, every field checked
//   update         anyone who runs it; only the name, note and open/closed flag can change
//   delete         anyone who runs it, and only together with a tombstone (below)
//
// events/{eventId}/responses/{uid}     one answer per person; the document id is their user id
//   read one       that person, or anyone who runs the event
//   list           anyone who runs the event, at most 500 at a time
//   create/update  that person, while the event is open, with every field checked, and not
//                  more often than once every five seconds
//   delete         that person, or anyone who runs the event
//
// events/{eventId}/invites/{inviteId}  a one-time link for a friend to run the event too
//   create         anyone who runs the event, with a full-length random id
//   read, delete   anyone who runs the event; also the friend using it up as they join
//   nothing else   never changed; good for seven days
//
// events/{eventId}/owners/{uid}        a friend who runs the event; the document id is their user id
//   create         that person, with a confirmed email, using up an invite in the same batch
//   read one       that person, or anyone who runs the event
//   list           anyone who runs the event (at most 50); across events, only your own entries
//   delete         that person (leaving), or anyone who runs the event
//   nothing else   never changed
//
// tombstones/{eventId}                 marks the id of a deleted event as used up for ever
//   write          anyone who runs that event, while the event still exists
//   nothing else   never read, never removed, never changed once the event is gone
//
// Everything else is refused.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Invitees are signed in "anonymously" so that each browser has an identity of its own.
    // Only people with a real account, whose email address they have confirmed, may create events.
    function hasConfirmedAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email_verified == true;
    }

    function eventPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }

    function ownerPath(eventId, uid) {
      return /databases/$(database)/documents/events/$(eventId)/owners/$(uid);
    }

    function invitePath(eventId, inviteId) {
      return /databases/$(database)/documents/events/$(eventId)/invites/$(inviteId);
    }

    // Made the event, or joined it through an invite. `exists` sees the database as it was
    // before this request, so someone can leave in the same batch that deletes the event.
    // The event itself must exist: an entry left behind by a deleted event opens nothing.
    function runsEvent(eventId) {
      return signedIn()
        && exists(eventPath(eventId))
        && (get(eventPath(eventId)).data.ownerUid == request.auth.uid
            || exists(ownerPath(eventId, request.auth.uid)));
    }

    function eventFields() {
      return ['ownerUid', 'title', 'description', 'timezone', 'dates', 'startMinute', 'endMinute',
              'slotMinutes', 'dayStarts', 'slotCount', 'open', 'createdAt', 'updatedAt'];
    }

    // `dates` is a list of 1-31 different "YYYY-MM-DD" strings. Rules cannot loop, so the list is
    // joined and checked as one string. Splitting it again must give back the same list, which
    // stops one entry from hiding several days or being something other than text.
    function validDates(dates) {
      return dates is list
        && dates.size() >= 1
        && dates.size() <= 31
        && dates.join(',').matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])(,[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))*$')
        && dates.join(',').split(',') == dates
        && dates.toSet().size() == dates.size();
    }

    // `dayStarts` is the instant each day's window opens, as whole minutes since 1970: one
    // eight-digit number per day (eight digits covers the years 1989 to 2160), joined with commas
    // into a single string so that every part of it can be checked here.
    function validDayStarts(starts, days) {
      return starts is string
        && starts.size() == days * 9 - 1
        && starts.matches('^[0-9]{8}(,[0-9]{8})*$');
    }

    // Deleting an event leaves a tombstone under the same id. While it exists the id cannot be
    // used for a new event, so an invite link can never come to point at somebody else's event
    // and answers left over from the old one can never fall into new hands.
    function tombstonePath(eventId) {
      return /databases/$(database)/documents/tombstones/$(eventId);
    }

    function validEvent(e) {
      return e.keys().hasOnly(eventFields())
        && e.keys().hasAll(eventFields())
        && e.ownerUid is string
        && e.title is string && e.title.size() >= 1 && e.title.size() <= 100
        && e.description is string && e.description.size() <= 500
        && e.timezone is string && e.timezone.size() <= 64
        && e.timezone.matches('^[A-Za-z][A-Za-z0-9_+/-]*$')
        && validDates(e.dates)
        && e.slotMinutes is int && e.slotMinutes in [15, 30, 60]
        && e.startMinute is int && e.startMinute >= 0 && e.startMinute < 1440 && e.startMinute % 15 == 0
        && e.endMinute is int && e.endMinute > e.startMinute && e.endMinute - e.startMinute <= 1440
        && (e.endMinute - e.startMinute) % e.slotMinutes == 0
        && validDayStarts(e.dayStarts, e.dates.size())
        && e.slotCount is int
        && e.slotCount == e.dates.size() * ((e.endMinute - e.startMinute) / e.slotMinutes)
        && e.open is bool
        && e.createdAt is timestamp
        && e.updatedAt is timestamp;
    }

    match /events/{eventId} {
      allow get: if true;

      allow list: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.query.limit <= 100;

      // The id is the secret in the invite link, so it must be a full-length random one.
      allow create: if hasConfirmedAccount()
        && eventId.matches('^[A-Za-z0-9]{20}$')
        && !exists(tombstonePath(eventId))
        && request.resource.data.ownerUid == request.auth.uid
        && validEvent(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || exists(ownerPath(eventId, request.auth.uid)))
        && validEvent(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'description', 'open', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || exists(ownerPath(eventId, request.auth.uid)))
        && existsAfter(tombstonePath(eventId));

      match /responses/{uid} {
        function isSelf() {
          return signedIn() && request.auth.uid == uid;
        }

        function answerFields() {
          return ['name', 'slots', 'createdAt', 'updatedAt'];
        }

        // An answer is one "0" or "1" per slot of the event, and is only accepted while the
        // event is open.
        function validAnswer(a) {
          let event = get(eventPath(eventId)).data;
          return event.open == true
            && a.keys().hasOnly(answerFields())
            && a.keys().hasAll(answerFields())
            && a.name is string && a.name.size() >= 1 && a.name.size() <= 60
            && a.slots is string && a.slots.size() == event.slotCount && a.slots.matches('^[01]+$')
            && a.createdAt is timestamp
            && a.updatedAt == request.time;
        }

        // Saving is free of charge for the person doing it but not for the site's owner, so
        // one person may change (or delete and re-create) their answer at most every five
        // seconds. The page waits out the rest of the five seconds by itself.
        function notJustSaved() {
          return request.time >= resource.data.updatedAt + duration.value(5, 's');
        }

        allow get: if isSelf() || runsEvent(eventId);
        allow list: if runsEvent(eventId) && request.query.limit <= 500;

        allow create: if isSelf()
          && validAnswer(request.resource.data)
          && request.resource.data.createdAt == request.time;

        allow update: if isSelf()
          && notJustSaved()
          && validAnswer(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if (isSelf() && notJustSaved()) || runsEvent(eventId);
      }

      match /invites/{inviteId} {
        // The id is the secret in the link, so it must be a full-length random one.
        allow create: if runsEvent(eventId)
          && inviteId.matches('^[A-Za-z0-9]{20}$')
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.keys().hasAll(['createdAt'])
          && request.resource.data.createdAt == request.time;

        allow get: if runsEvent(eventId);
        allow list: if runsEvent(eventId) && request.query.limit <= 100;

        // Whoever runs the event may throw an invite away. The friend it was for uses it up by
        // naming it in the owners entry they create in the same batch.
        allow delete: if runsEvent(eventId)
          || (signedIn()
              && !exists(ownerPath(eventId, request.auth.uid))
              && getAfter(ownerPath(eventId, request.auth.uid)).data.invite == inviteId);
      }

      match /owners/{uid} {
        function isSelf() {
          return signedIn() && request.auth.uid == uid;
        }

        // Joining: a confirmed account writes itself in, naming an invite of this event that is
        // less than a week old, and deletes that invite in the same batch, so it works once.
        function validJoin(o) {
          let invite = invitePath(eventId, o.invite);
          return o.keys().hasOnly(['uid', 'name', 'invite', 'at'])
            && o.keys().hasAll(['uid', 'name', 'invite', 'at'])
            && o.uid == uid
            && o.name is string && o.name.size() <= 60
            && o.invite is string && o.invite.matches('^[A-Za-z0-9]{20}$')
            && o.at == request.time
            && exists(invite)
            && request.time < get(invite).data.createdAt + duration.value(7, 'd')
            && !existsAfter(invite);
        }

        allow create: if isSelf()
          && hasConfirmedAccount()
          && exists(eventPath(eventId))
          && get(eventPath(eventId)).data.ownerUid != uid
          && validJoin(request.resource.data);

        allow get: if isSelf() || runsEvent(eventId);
        allow list: if runsEvent(eventId) && request.query.limit <= 50;
        allow delete: if isSelf() || runsEvent(eventId);
      }
    }

    // "Your events" finds the events you run with others by looking up your own entries.
    match /{path=**}/owners/{uid} {
      allow list: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.query.limit <= 100;
    }

    match /tombstones/{eventId} {
      // "update" as well as "create", so that deleting an event works even if its tombstone
      // was somehow written earlier. Either way it needs the event to exist and to be yours,
      // so once the event is gone its tombstone can never be touched again.
      allow create, update: if runsEvent(eventId)
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.keys().hasAll(['at'])
        && request.resource.data.at == request.time;
    }
  }
}
